Subject: [PATCH] Inject the PROXY protocol metadata as the X-Proxy-Meta header

Assisted-by: Claude Opus 5
---
 pkg/server/proxy_protocol_meta.go      | 22 +++++++
 pkg/server/proxy_protocol_meta_test.go | 82 ++++++++++++++++++++++++++
 pkg/server/server_entrypoint_tcp.go    |  2 +-
 3 files changed, 105 insertions(+), 1 deletion(-)

diff --git a/pkg/server/proxy_protocol_meta.go b/pkg/server/proxy_protocol_meta.go
index be457fb34..40fd6202d 100644
--- a/pkg/server/proxy_protocol_meta.go
+++ b/pkg/server/proxy_protocol_meta.go
@@ -3,6 +3,7 @@ package server
 import (
 	"context"
 	"net"
+	"net/http"
 
 	"github.com/pires/go-proxyproto"
 	"github.com/rs/zerolog/log"
@@ -117,3 +118,24 @@ func addProxyProtocolMetaInContext(ctx context.Context, c net.Conn) context.Cont
 
 	return context.WithValue(ctx, proxyProtocolMetaKey{}, values)
 }
+
+// proxyProtocolMeta replaces the X-Proxy-Meta header with the values carried by
+// the connection PROXY protocol header.
+// It is an alice.Constructor, so that it can be mounted at the head of the
+// entryPoint handler chain, ahead of the HTTP router.
+func proxyProtocolMeta(next http.Handler) (http.Handler, error) {
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		// The removal is unconditional, whether the entryPoint enables proxyProtocol
+		// or not: it is the only thing making the header trustworthy, a backend seeing
+		// it knows it comes from a TLV.
+		req.Header.Del(proxyMetaHeader)
+
+		if values, ok := req.Context().Value(proxyProtocolMetaKey{}).([]string); ok {
+			for _, value := range values {
+				req.Header.Add(proxyMetaHeader, value)
+			}
+		}
+
+		next.ServeHTTP(rw, req)
+	}), nil
+}
