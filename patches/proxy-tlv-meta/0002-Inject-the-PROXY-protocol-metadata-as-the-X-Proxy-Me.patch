+func TestProxyProtocolMeta(t *testing.T) {
+	testCases := []struct {
+		desc          string
+		values        []string
+		clientHeaders http.Header
+		expected      []string
+	}{
+		{
+			desc:          "no metadata, forged client header",
+			clientHeaders: http.Header{proxyMetaHeader: []string{"evil"}},
+		},
+		{
+			desc:          "one value, forged client header",
+			values:        []string{"tenant=acme"},
+			clientHeaders: http.Header{proxyMetaHeader: []string{"evil"}},
+			expected:      []string{"tenant=acme"},
+		},
+		{
+			desc:     "several values",
+			values:   []string{"first", "second"},
+			expected: []string{"first", "second"},
+		},
+		{
+			desc:          "several values, several forged client values",
+			values:        []string{"first", "second"},
+			clientHeaders: http.Header{proxyMetaHeader: []string{"evil", "eviler"}},
+			expected:      []string{"first", "second"},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			var got []string
+			handler, err := proxyProtocolMeta(http.HandlerFunc(func(_ http.ResponseWriter, req *http.Request) {
+				got = req.Header.Values(proxyMetaHeader)
+			}))
+			require.NoError(t, err)
+
+			req := httptest.NewRequest(http.MethodGet, "http://example.com", nil)
+			for name, values := range test.clientHeaders {
+				for _, value := range values {
+					req.Header.Add(name, value)
+				}
+			}
+
+			if test.values != nil {
+				req = req.WithContext(context.WithValue(req.Context(), proxyProtocolMetaKey{}, test.values))
+			}
+
+			handler.ServeHTTP(httptest.NewRecorder(), req)
+
+			assert.Equal(t, test.expected, got)
+		})
+	}
+}
+
+// TestProxyProtocolMetaStripsNonCanonicalHeader reads the request off the wire, so
+// that the forged header goes through the net/http name canonicalization the
+// removal relies on.
+func TestProxyProtocolMetaStripsNonCanonicalHeader(t *testing.T) {
+	var got []string
+	handler, err := proxyProtocolMeta(http.HandlerFunc(func(_ http.ResponseWriter, req *http.Request) {
+		got = req.Header.Values(proxyMetaHeader)
+	}))
+	require.NoError(t, err)
+
+	raw := "GET / HTTP/1.1\r\nHost: example.com\r\nx-proxy-meta: evil\r\nX-PROXY-META: eviler\r\n\r\n"
+	req, err := http.ReadRequest(bufio.NewReader(strings.NewReader(raw)))
+	require.NoError(t, err)
+	require.Equal(t, []string{"evil", "eviler"}, req.Header.Values(proxyMetaHeader))
+
+	handler.ServeHTTP(httptest.NewRecorder(), req)
+
+	assert.Empty(t, got)
+}
+
