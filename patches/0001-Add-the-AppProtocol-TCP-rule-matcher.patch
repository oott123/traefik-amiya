 )
 
+// Application protocols detected on the decrypted stream by the post-TLS routing stage,
+// and accepted as the AppProtocol matcher value.
+const (
+	AppProtoHTTP1   = "http/1.1"
+	AppProtoH2      = "h2"
+	AppProtoUnknown = "unknown"
+)
+
 var tcpFuncs = map[string]func(*matchersTree, ...string) error{
 	"ALPN":          expect1Parameter(alpn),
+	"AppProtocol":   expect1Parameter(appProtocol),
 	"ClientIP":      expect1Parameter(clientIP),
 	"HostSNI":       expect1Parameter(hostSNI),
 	"HostSNIRegexp": expect1Parameter(hostSNIRegexp),
@@ -44,6 +53,22 @@ func alpn(tree *matchersTree, protos ...string) error {
 	return nil
 }
 
+// appProtocol checks the application protocol sniffed on the decrypted stream,
+// after the TLS handshake completed.
+func appProtocol(tree *matchersTree, protos ...string) error {
+	proto := protos[0]
+
+	if proto != AppProtoHTTP1 && proto != AppProtoH2 && proto != AppProtoUnknown {
+		return fmt.Errorf("invalid value for AppProtocol matcher, %q is not a valid application protocol", proto)
+	}
+
+	tree.matcher = func(meta ConnData) bool {
+		return meta.appProto == proto
+	}
+
+	return nil
+}
+
