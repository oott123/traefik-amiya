+func Test_AppProtocol(t *testing.T) {
+	testCases := []struct {
+		desc     string
+		rule     string
+		expected map[string]bool
+		buildErr bool
+	}{
+		{
+			desc:     "Invalid AppProtocol matcher (empty parameters)",
+			rule:     "AppProtocol(``)",
+			buildErr: true,
+		},
+		{
+			desc:     "Invalid AppProtocol matcher (too many parameters)",
+			rule:     "AppProtocol(`h2`, `http/1.1`)",
+			buildErr: true,
+		},
+		{
+			desc:     "Invalid AppProtocol matcher (unknown protocol)",
+			rule:     "AppProtocol(`mqtt`)",
+			buildErr: true,
+		},
+		{
+			desc:     "Invalid AppProtocol matcher (ALPN protocol not in the value domain)",
+			rule:     "AppProtocol(`acme-tls/1`)",
+			buildErr: true,
+		},
+		{
+			desc:     "Invalid AppProtocol matcher (HTTP/1.0 is not a value)",
+			rule:     "AppProtocol(`http/1.0`)",
+			buildErr: true,
+		},
+		{
+			desc:     "Invalid AppProtocol matcher (values are case-sensitive)",
+			rule:     "AppProtocol(`H2`)",
+			buildErr: true,
+		},
+		{
+			desc: "Valid AppProtocol matcher (h2)",
+			rule: "AppProtocol(`h2`)",
+			expected: map[string]bool{
+				"h2":       true,
+				"http/1.1": false,
+				"unknown":  false,
+				"":         false,
+			},
+		},
+		{
+			desc: "Valid AppProtocol matcher (http/1.1)",
+			rule: "AppProtocol(`http/1.1`)",
+			expected: map[string]bool{
+				"h2":       false,
+				"http/1.1": true,
+				"unknown":  false,
+				"":         false,
+			},
+		},
+		{
+			desc: "Valid AppProtocol matcher (unknown)",
+			rule: "AppProtocol(`unknown`)",
+			expected: map[string]bool{
+				"h2":       false,
+				"http/1.1": false,
+				"unknown":  true,
+				"":         false,
+			},
+		},
+		{
+			desc: "Valid AppProtocol matcher (negated)",
+			rule: "!AppProtocol(`unknown`)",
+			expected: map[string]bool{
+				"h2":       true,
+				"http/1.1": true,
+				"unknown":  false,
+				"":         true,
+			},
+		},
+		{
+			desc: "Valid AppProtocol matcher (lower case matcher name)",
+			rule: "appprotocol(`unknown`)",
+			expected: map[string]bool{
+				"unknown": true,
+				"h2":      false,
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			muxer, err := NewMuxer(nil)
+			require.NoError(t, err)
+
+			err = muxer.AddRoute(test.rule, "", 0, "", tcp.HandlerFunc(func(conn tcp.WriteCloser) {}))
+			if test.buildErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+
+			for proto, match := range test.expected {
+				handler, _ := muxer.Match(ConnData{appProto: proto})
+				assert.Equal(t, match, handler != nil, proto)
+			}
+		})
+	}
+}
