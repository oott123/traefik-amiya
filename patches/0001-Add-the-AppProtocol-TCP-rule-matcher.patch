+func Test_WithAppProtocol(t *testing.T) {
+	connData, err := NewConnData("Example.com", &net.TCPAddr{IP: net.IPv4(10, 0, 0, 1), Port: 4242}, []string{"h2", "http/1.1"})
+	require.NoError(t, err)
+
+	withAppProto := connData.WithAppProtocol("unknown")
+
+	assert.Equal(t, "unknown", withAppProto.appProto)
+	assert.Equal(t, "example.com", withAppProto.serverName)
+	assert.Equal(t, "10.0.0.1", withAppProto.remoteIP)
+	assert.Equal(t, []string{"h2", "http/1.1"}, withAppProto.alpnProtos)
+
+	// The receiver must not be mutated, a connection is matched against several routes.
+	assert.Empty(t, connData.appProto)
+}
+
+func Test_HasAppProtocolMatcher(t *testing.T) {
+	testCases := []struct {
+		desc      string
+		rule      string
+		syntax    string
+		expected  bool
+		expectErr bool
+	}{
+		{
+			desc:     "No AppProtocol matcher",
+			rule:     "HostSNI(`example.com`)",
+			expected: false,
+		},
+		{
+			desc:     "AppProtocol matcher alone",
+			rule:     "AppProtocol(`unknown`)",
+			expected: true,
+		},
+		{
+			desc:     "AppProtocol matcher combined",
+			rule:     "HostSNI(`example.com`) && AppProtocol(`unknown`)",
+			expected: true,
+		},
+		{
+			desc:     "Negated AppProtocol matcher",
+			rule:     "HostSNI(`example.com`) && !AppProtocol(`http/1.1`)",
+			expected: true,
+		},
+		{
+			desc:     "AppProtocol matcher with an invalid value is still detected",
+			rule:     "AppProtocol(`mqtt`)",
+			expected: true,
+		},
+		{
+			desc:      "AppProtocol matcher is not supported by the v2 syntax",
+			rule:      "AppProtocol(`unknown`)",
+			syntax:    "v2",
+			expectErr: true,
+		},
+		{
+			desc:      "Unparsable rule",
+			rule:      "HostSNI(`example.com`",
+			expectErr: true,
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			muxer, err := NewMuxer(nil)
+			require.NoError(t, err)
+
+			hasMatcher, err := muxer.HasAppProtocolMatcher(test.rule, test.syntax)
+			if test.expectErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+
+			assert.Equal(t, test.expected, hasMatcher)
+		})
+	}
+}
