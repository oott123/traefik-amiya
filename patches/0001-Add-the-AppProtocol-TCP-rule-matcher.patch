+func Test_AppProtocolCombination(t *testing.T) {
+	testCases := []struct {
+		desc  string
+		rule  string
+		meta  ConnData
+		match bool
+	}{
+		{
+			desc: "HostSNI and AppProtocol both match",
+			rule: "HostSNI(`example.com`) && AppProtocol(`unknown`)",
+			meta: ConnData{
+				serverName: "example.com",
+				appProto:   "unknown",
+			},
+			match: true,
+		},
+		{
+			desc: "HostSNI matches but AppProtocol does not",
+			rule: "HostSNI(`example.com`) && AppProtocol(`unknown`)",
+			meta: ConnData{
+				serverName: "example.com",
+				appProto:   "http/1.1",
+			},
+		},
+		{
+			desc: "AppProtocol matches but HostSNI does not",
+			rule: "HostSNI(`example.com`) && AppProtocol(`unknown`)",
+			meta: ConnData{
+				serverName: "example.org",
+				appProto:   "unknown",
+			},
+		},
+		{
+			// The ALPN matcher keeps matching the protocols offered in the ClientHello,
+			// even when combined with AppProtocol.
+			desc: "ALPN and AppProtocol",
+			rule: "ALPN(`h2`) && AppProtocol(`unknown`)",
+			meta: ConnData{
+				alpnProtos: []string{"h2", "http/1.1"},
+				appProto:   "unknown",
+			},
+			match: true,
+		},
+		{
+			desc: "ClientIP and AppProtocol",
+			rule: "ClientIP(`10.0.0.0/8`) && AppProtocol(`h2`)",
+			meta: ConnData{
+				remoteIP: "10.1.2.3",
+				appProto: "h2",
+			},
+			match: true,
+		},
+		{
+			desc: "HostSNIRegexp or AppProtocol",
+			rule: "HostSNIRegexp(`^foo\\..*$`) || AppProtocol(`unknown`)",
+			meta: ConnData{
+				serverName: "bar.example.com",
+				appProto:   "unknown",
+			},
+			match: true,
+		},
+		{
+			desc: "Negated AppProtocol combined with HostSNI",
+			rule: "HostSNI(`example.com`) && !AppProtocol(`http/1.1`)",
+			meta: ConnData{
+				serverName: "example.com",
+				appProto:   "http/1.1",
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			muxer, err := NewMuxer(nil)
+			require.NoError(t, err)
+
+			err = muxer.AddRoute(test.rule, "", 0, "", tcp.HandlerFunc(func(conn tcp.WriteCloser) {}))
+			require.NoError(t, err)
+
+			handler, _ := muxer.Match(test.meta)
+			assert.Equal(t, test.match, handler != nil)
+		})
+	}
+}
