+// WithAppProtocol returns a copy of the ConnData with the given application protocol.
+// The post-TLS routing stage reuses the ClientHello stage ConnData instead of building
+// a new one, so that a given matcher keeps the exact same semantics in both stages:
+// ALPN then still matches the protocols offered by the client, not the negotiated one.
+func (c ConnData) WithAppProtocol(appProto string) ConnData {
+	c.appProto = appProto
+	return c
+}
+
 // Muxer defines a muxer that handles TCP routing with rules.
 type Muxer struct {
 	routes routes
@@ -184,6 +196,29 @@ func (m *Muxer) HasRoutes() bool {
 	return len(m.routes) > 0
 }
 
+// HasAppProtocolMatcher returns whether the given rule uses the AppProtocol matcher.
+// It relies on the muxer parsers, and not on a dedicated one, so that a rule using
+// AppProtocol with the v2 syntax reports the unknown matcher error instead of being
+// silently accepted.
+func (m *Muxer) HasAppProtocolMatcher(rule, syntax string) (bool, error) {
+	parser := m.parser
+	if syntax == "v2" {
+		parser = m.parserV2
+	}
+
+	parse, err := parser.Parse(rule)
+	if err != nil {
+		return false, fmt.Errorf("error while parsing rule %s: %w", rule, err)
+	}
+
+	buildTree, ok := parse.(rules.TreeBuilder)
+	if !ok {
+		return false, fmt.Errorf("error while parsing rule %s", rule)
+	}
+
+	return len(buildTree().ParseMatchers([]string{"AppProtocol"})) > 0, nil
+}
