diff --git a/integration/fixtures/appproto/generate_cert.sh b/integration/fixtures/appproto/generate_cert.sh
new file mode 100644
index 000000000..60dfa145f
--- /dev/null
+++ b/integration/fixtures/appproto/generate_cert.sh
@@ -0,0 +1,7 @@
+openssl req -newkey rsa:2048 \
+  -new -nodes -x509 \
+  -days 3650 \
+  -out appproto.test.cert \
+  -keyout appproto.test.key \
+  -subj "/CN=appproto.test" \
+  -addext "subjectAltName = DNS:appproto.test"
diff --git a/integration/fixtures/appproto/simple.toml b/integration/fixtures/appproto/simple.toml
new file mode 100644
index 000000000..77d40c57d
--- /dev/null
+++ b/integration/fixtures/appproto/simple.toml
@@ -0,0 +1,49 @@
+[global]
+  checkNewVersion = false
+  sendAnonymousUsage = false
+
+[log]
+  level = "DEBUG"
+  noColor = true
+
+[entryPoints]
+  [entryPoints.websecure]
+    address = ":8093"
+
+[api]
+  insecure = true
+
+[providers.file]
+  filename = "{{ .SelfFilename }}"
+
+## dynamic configuration ##
+
+[http]
+  [http.routers]
+    [http.routers.whoami]
+      entryPoints = ["websecure"]
+      rule = "Host(`appproto.test`)"
+      service = "whoami"
+      [http.routers.whoami.tls]
+
+  [http.services]
+    [http.services.whoami.loadBalancer]
+      [[http.services.whoami.loadBalancer.servers]]
+        url = "{{ .Whoami }}"
+
+[tcp]
+  [tcp.routers]
+    [tcp.routers.fallback]
+      entryPoints = ["websecure"]
+      rule = "HostSNI(`appproto.test`) && AppProtocol(`unknown`)"
+      service = "whoami-tcp"
+      [tcp.routers.fallback.tls]
+
+  [tcp.services]
+    [tcp.services.whoami-tcp.loadBalancer]
+      [[tcp.services.whoami-tcp.loadBalancer.servers]]
+        address = "{{ .WhoamiTCP }}"
+
+[[tls.certificates]]
+  certFile = "fixtures/appproto/appproto.test.cert"
+  keyFile = "fixtures/appproto/appproto.test.key"
