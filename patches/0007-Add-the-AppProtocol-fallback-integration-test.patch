index 000000000..07fd67c03
--- /dev/null
+++ b/integration/appproto_test.go
@@ -0,0 +1,162 @@
+package integration
+
+import (
+	"crypto/tls"
+	"fmt"
+	"io"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/stretchr/testify/suite"
+	"github.com/traefik/traefik/v3/integration/try"
+	"golang.org/x/net/http2"
+)
+
+type AppProtoSuite struct{ BaseSuite }
+
+func TestAppProtoSuite(t *testing.T) {
+	suite.Run(t, new(AppProtoSuite))
+}
+
+func (s *AppProtoSuite) SetupSuite() {
+	s.BaseSuite.SetupSuite()
+
+	s.createComposeProject("appproto")
+	s.composeUp()
+}
+
+func (s *AppProtoSuite) TearDownSuite() {
+	s.BaseSuite.TearDownSuite()
+}
+
+// TestFallback covers an entryPoint serving a regular HTTPS site alongside a TCP
+// router picking up the connections whose decrypted payload is not HTTP.
+func (s *AppProtoSuite) TestFallback() {
+	file := s.adaptFile("fixtures/appproto/simple.toml", struct {
+		Whoami    string
+		WhoamiTCP string
+	}{
+		Whoami:    "http://" + s.getComposeServiceIP("whoami") + ":80",
+		WhoamiTCP: s.getComposeServiceIP("whoami-tcp") + ":8080",
+	})
+
+	s.traefikCmd(withConfigFile(file))
+
+	err := try.GetRequest("http://127.0.0.1:8080/api/rawdata", 5*time.Second,
+		try.StatusCodeIs(http.StatusOK), try.BodyContains("AppProtocol(`unknown`)"))
+	require.NoError(s.T(), err)
+
+	tlsConfig := func(alpnProtos []string) *tls.Config {
+		return &tls.Config{
+			InsecureSkipVerify: true,
+			ServerName:         "appproto.test",
+			NextProtos:         alpnProtos,
+		}
+	}
+
+	s.Run("HTTP/1.1 request is served by the HTTP router", func() {
+		transport := &http.Transport{TLSClientConfig: tlsConfig([]string{"http/1.1"})}
+
+		req, err := http.NewRequest(http.MethodGet, "https://127.0.0.1:8093/", nil)
+		require.NoError(s.T(), err)
+		req.Host = "appproto.test"
+
+		err = try.RequestWithTransport(req, 10*time.Second, transport,
+			try.StatusCodeIs(http.StatusOK), try.BodyContains("X-Forwarded-Proto: https"))
+		require.NoError(s.T(), err)
+	})
+
+	// HTTP/2 goes through the unencrypted_http2 channel once the connection has been
+	// sniffed, and its Request.TLS is restored by Traefik: this is the regression
+	// sentinel for both.
+	s.Run("HTTP/2 request is served by the HTTP router", func() {
+		transport := &http.Transport{TLSClientConfig: tlsConfig([]string{"h2"})}
+		require.NoError(s.T(), http2.ConfigureTransport(transport))
+
+		req, err := http.NewRequest(http.MethodGet, "https://127.0.0.1:8093/", nil)
+		require.NoError(s.T(), err)
+		req.Host = "appproto.test"
+
+		err = try.RequestWithTransport(req, 10*time.Second, transport,
+			try.StatusCodeIs(http.StatusOK),
+			func(res *http.Response) error {
+				if res.ProtoMajor != 2 {
+					return fmt.Errorf("got HTTP/%d, want HTTP/2", res.ProtoMajor)
+				}
+				return nil
+			},
+			try.BodyContains("X-Forwarded-Proto: https"))
+		require.NoError(s.T(), err)
+	})
+
+	// A method the sniffer only accepts because it applies the RFC 9110 token rule
+	// instead of a hardcoded allow-list.
+	s.Run("PROPFIND request is served by the HTTP router", func() {
+		transport := &http.Transport{TLSClientConfig: tlsConfig([]string{"http/1.1"})}
+
+		req, err := http.NewRequest("PROPFIND", "https://127.0.0.1:8093/", nil)
+		require.NoError(s.T(), err)
+		req.Host = "appproto.test"
+
+		err = try.RequestWithTransport(req, 10*time.Second, transport,
+			try.StatusCodeIs(http.StatusOK), try.BodyContains("X-Forwarded-Proto: https"))
+		require.NoError(s.T(), err)
+	})
+
+	for _, alpnProtos := range [][]string{{"http/1.1"}, {"h2"}} {
+		s.Run("Non-HTTP payload with ALPN "+alpnProtos[0]+" reaches the TCP service", func() {
+			out, err := writeAndRead(s.T(), tlsConfig(alpnProtos), "hello\n")
+			require.NoError(s.T(), err)
+			assert.Contains(s.T(), out, "whoami-tcp")
+		})
+	}
+
+	// A client completing the handshake without saying anything cannot be decided
+	// on, and must end up on the regular HTTPS path.
+	s.Run("Silent client is served by the HTTP router", func() {
+		conn, err := tls.Dial("tcp", "127.0.0.1:8093", tlsConfig([]string{"http/1.1"}))
+		require.NoError(s.T(), err)
+		defer conn.Close()
+
+		require.NoError(s.T(), conn.SetDeadline(time.Now().Add(10*time.Second)))
+
+		time.Sleep(600 * time.Millisecond)
+
+		_, err = conn.Write([]byte("GET / HTTP/1.1\r\nHost: appproto.test\r\nConnection: close\r\n\r\n"))
+		require.NoError(s.T(), err)
+
+		out, err := io.ReadAll(conn)
+		require.NoError(s.T(), err)
+		assert.Contains(s.T(), string(out), "X-Forwarded-Proto: https")
+	})
+}
+
+// writeAndRead opens a TLS connection, sends the payload, and returns the answer.
+func writeAndRead(t *testing.T, tlsConfig *tls.Config, payload string) (string, error) {
+	t.Helper()
+
+	conn, err := tls.Dial("tcp", "127.0.0.1:8093", tlsConfig)
+	if err != nil {
+		return "", err
+	}
+	defer conn.Close()
+
+	if err := conn.SetDeadline(time.Now().Add(10 * time.Second)); err != nil {
+		return "", err
+	}
+
+	if _, err := conn.Write([]byte(payload)); err != nil {
+		return "", err
+	}
+
+	out := make([]byte, 2048)
+	n, err := conn.Read(out)
+	if err != nil {
+		return "", err
+	}
+
+	return string(out[:n]), nil
+}
