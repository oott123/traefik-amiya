+// Test_SetHTTPSForwarder_noPostTLSRoute checks that an entryPoint without post-TLS
+// route keeps the exact same handler chain as before.
+func Test_SetHTTPSForwarder_noPostTLSRoute(t *testing.T) {
+	router, err := NewRouter(nil)
+	require.NoError(t, err)
+
+	router.httpsTLSConfig = &tls.Config{}
+	router.AddHTTPTLSConfig("test.localhost", &tls.Config{}, "default")
+
+	forwarder := traefiktcp.HandlerFunc(func(conn traefiktcp.WriteCloser) {})
+	router.SetHTTPSForwarder(forwarder, 0)
+
+	httpsForwarder, ok := router.httpsForwarder.(*traefiktcp.TLSHandler)
+	require.True(t, ok)
+	_, isPostTLS := httpsForwarder.Next.(*postTLSRouter)
+	assert.False(t, isPostTLS)
+
+	handler, _ := router.muxerHTTPS.Match(mustConnData(t, "test.localhost"))
+	tlsHandler, ok := handler.(*traefiktcp.TLSHandler)
+	require.True(t, ok)
+	_, isPostTLS = tlsHandler.Next.(*postTLSRouter)
+	assert.False(t, isPostTLS)
+}
+
+// Test_SetHTTPSForwarder_withPostTLSRoute checks that the second routing stage is
+// woven into every TLS handler of the entryPoint, and not only into the catchAll one.
+func Test_SetHTTPSForwarder_withPostTLSRoute(t *testing.T) {
+	router, err := NewRouter(nil)
+	require.NoError(t, err)
+
+	router.httpsTLSConfig = &tls.Config{}
+	router.AddHTTPTLSConfig("test.localhost", &tls.Config{}, "default")
+
+	err = router.AddPostTLSRoute("AppProtocol(`unknown`)", "", 0, "", traefiktcp.HandlerFunc(func(conn traefiktcp.WriteCloser) {}))
+	require.NoError(t, err)
+
+	router.SetHTTPSForwarder(traefiktcp.HandlerFunc(func(conn traefiktcp.WriteCloser) {}), 42*time.Second)
+
+	assert.Equal(t, 42*time.Second, router.tlsHandshakeTimeout)
+
+	httpsForwarder, ok := router.httpsForwarder.(*traefiktcp.TLSHandler)
+	require.True(t, ok)
+	_, isPostTLS := httpsForwarder.Next.(*postTLSRouter)
+	assert.True(t, isPostTLS)
+
+	handler, _ := router.muxerHTTPS.Match(mustConnData(t, "test.localhost"))
+	tlsHandler, ok := handler.(*traefiktcp.TLSHandler)
+	require.True(t, ok)
+	_, isPostTLS = tlsHandler.Next.(*postTLSRouter)
+	assert.True(t, isPostTLS)
+}
+
+func mustConnData(t *testing.T, serverName string) tcpmuxer.ConnData {
+	t.Helper()
+
+	connData, err := tcpmuxer.NewConnData(serverName, &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 4242}, nil)
+	require.NoError(t, err)
+
+	return connData
+}
