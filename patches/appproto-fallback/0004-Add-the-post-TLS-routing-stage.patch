+
+type postTLSTestRoute struct {
+	rule string
+	tag  string
+}
+
+// newPostTLSTestRouter starts a TCP router with the given post-TLS routes and returns
+// its address. A matching route answers with its tag, and the HTTPS forwarder answers
+// with the wrapper type it got, which is what decides how net/http serves the
+// connection.
+func newPostTLSTestRouter(t *testing.T, serverALPNProtos []string, routes ...postTLSTestRoute) string {
+	t.Helper()
+
+	certPEM, keyPEM, err := generate.KeyPair("test.localhost", time.Time{})
+	require.NoError(t, err)
+
+	cert, err := tls.X509KeyPair(certPEM, keyPEM)
+	require.NoError(t, err)
+
+	router, err := NewRouter(nil)
+	require.NoError(t, err)
+
+	router.httpsTLSConfig = &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		NextProtos:   serverALPNProtos,
+	}
+
+	for _, route := range routes {
+		tag := route.tag
+		err = router.AddPostTLSRoute(route.rule, "", 0, "", traefiktcp.HandlerFunc(func(conn traefiktcp.WriteCloser) {
+			_, _ = conn.Write([]byte(tag))
+			_ = conn.Close()
+		}))
+		require.NoError(t, err)
+	}
+
+	router.SetHTTPSForwarder(traefiktcp.HandlerFunc(func(conn traefiktcp.WriteCloser) {
+		kind := "bare"
+		if _, ok := conn.(TLSStatefulConn); ok {
+			kind = "stateful"
+		}
+
+		_, _ = conn.Write([]byte("next:" + kind))
+		_ = conn.Close()
+	}), 0)
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = ln.Close() })
+
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+
+			go router.ServeTCP(conn.(*net.TCPConn))
+		}
+	}()
+
+	return ln.Addr().String()
+}
+
+// dialPostTLS opens a TLS connection, sends the payload after waiting for the given
+// delay, and returns everything the server sent back.
+func dialPostTLS(t *testing.T, addr string, clientALPNProtos []string, payload string, delay time.Duration) string {
+	t.Helper()
+
+	conn, err := tls.Dial("tcp", addr, &tls.Config{
+		ServerName:         "test.localhost",
+		InsecureSkipVerify: true,
+		NextProtos:         clientALPNProtos,
+	})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+
+	require.NoError(t, conn.SetDeadline(time.Now().Add(5*time.Second+delay)))
+
+	if delay > 0 {
+		time.Sleep(delay)
+	}
+
+	if payload != "" {
+		_, err = conn.Write([]byte(payload))
+		require.NoError(t, err)
+	}
+
+	got, err := io.ReadAll(conn)
+	require.NoError(t, err)
+
+	return string(got)
+}
+
+func Test_PostTLSRouting(t *testing.T) {
+	const fallbackRule = "HostSNI(`test.localhost`) && AppProtocol(`unknown`)"
+
+	testCases := []struct {
+		desc             string
+		serverALPNProtos []string
+		clientALPNProtos []string
+		rule             string
+		payload          string
+		delay            time.Duration
+		expected         string
+	}{
+		{
+			desc:             "HTTP/1.1 payload keeps going down the HTTPS path",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"http/1.1"},
+			rule:             fallbackRule,
+			payload:          "GET / HTTP/1.1\r\nHost: test.localhost\r\n\r\n",
+			expected:         "next:stateful",
+		},
+		{
+			desc:             "Non-HTTP payload reaches the fallback service",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"http/1.1"},
+			rule:             fallbackRule,
+			payload:          "\x05\x01\x00some binary payload",
+			expected:         "fallback",
+		},
+		{
+			desc:             "HTTP/2 preface on an h2 connection keeps going down the HTTPS path",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"h2"},
+			rule:             fallbackRule,
+			payload:          string(http2Preface) + "\x00\x00\x00\x04\x00\x00\x00\x00\x00",
+			expected:         "next:bare",
+		},
+		{
+			desc:             "HTTP/1.1 payload on an h2 connection reaches the fallback service",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"h2"},
+			rule:             fallbackRule,
+			payload:          "GET / HTTP/1.1\r\nHost: test.localhost\r\n\r\n",
+			expected:         "fallback",
+		},
+		{
+			desc:             "Non-HTTP payload on an h2 connection reaches the fallback service",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"h2"},
+			rule:             fallbackRule,
+			payload:          "\x05\x01\x00some binary payload",
+			expected:         "fallback",
+		},
+		{
+			desc:             "A connection saying nothing keeps going down the HTTPS path",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"http/1.1"},
+			rule:             fallbackRule,
+			delay:            appProtoSniffTimeout + 200*time.Millisecond,
+			payload:          "GET / HTTP/1.1\r\nHost: test.localhost\r\n\r\n",
+			expected:         "next:stateful",
+		},
+		{
+			desc:             "A non-matching HostSNI keeps going down the HTTPS path",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"http/1.1"},
+			rule:             "HostSNI(`other.localhost`) && AppProtocol(`unknown`)",
+			payload:          "\x05\x01\x00some binary payload",
+			expected:         "next:stateful",
+		},
+		{
+			desc:             "AppProtocol(`http/1.1`) matches an HTTP payload",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"http/1.1"},
+			rule:             "AppProtocol(`http/1.1`)",
+			payload:          "PROPFIND /dav HTTP/1.1\r\nHost: test.localhost\r\n\r\n",
+			expected:         "fallback",
+		},
+		{
+			desc:             "AppProtocol(`h2`) matches a preface",
+			serverALPNProtos: []string{"h2", "http/1.1"},
+			clientALPNProtos: []string{"h2"},
+			rule:             "AppProtocol(`h2`)",
+			payload:          string(http2Preface),
+			expected:         "fallback",
+		},
+		{
+			// The ALPN matcher matches the protocols offered in the ClientHello, not
+			// the negotiated one, in the post-TLS stage as anywhere else. The server
+			// only offering http/1.1 is what makes the two differ: negotiation is
+			// server-order-first, so a client offering h2 against the default Traefik
+			// list would always end up negotiating h2.
+			desc:             "The ALPN matcher still matches the offered protocols",
+			serverALPNProtos: []string{"http/1.1"},
+			clientALPNProtos: []string{"h2", "http/1.1"},
+			rule:             "ALPN(`h2`) && AppProtocol(`unknown`)",
+			payload:          "\x05\x01\x00some binary payload",
+			expected:         "fallback",
+		},
+		{
+			desc:             "The ALPN matcher does not match a protocol which was not offered",
+			serverALPNProtos: []string{"http/1.1"},
+			clientALPNProtos: []string{"http/1.1"},
+			rule:             "ALPN(`h2`) && AppProtocol(`unknown`)",
+			payload:          "\x05\x01\x00some binary payload",
+			expected:         "next:stateful",
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			addr := newPostTLSTestRouter(t, test.serverALPNProtos, postTLSTestRoute{rule: test.rule, tag: "fallback"})
+
+			assert.Equal(t, test.expected, dialPostTLS(t, addr, test.clientALPNProtos, test.payload, test.delay))
+		})
+	}
+}
+
+// Test_PostTLSRouting_replay checks that the bytes consumed while sniffing are
+// handed over to the fallback service.
+func Test_PostTLSRouting_replay(t *testing.T) {
+	certPEM, keyPEM, err := generate.KeyPair("test.localhost", time.Time{})
+	require.NoError(t, err)
+
+	cert, err := tls.X509KeyPair(certPEM, keyPEM)
+	require.NoError(t, err)
+
+	router, err := NewRouter(nil)
+	require.NoError(t, err)
+
+	router.httpsTLSConfig = &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		NextProtos:   []string{"h2", "http/1.1"},
+	}
+
+	payload := "\x05\x01\x00some binary payload"
+
+	err = router.AddPostTLSRoute("AppProtocol(`unknown`)", "", 0, "", traefiktcp.HandlerFunc(func(conn traefiktcp.WriteCloser) {
+		got := make([]byte, len(payload))
+		_, err := io.ReadFull(conn, got)
+		assert.NoError(t, err)
+		_, _ = conn.Write(got)
+		_ = conn.Close()
+	}))
+	require.NoError(t, err)
+
+	router.SetHTTPSForwarder(traefiktcp.HandlerFunc(func(conn traefiktcp.WriteCloser) {
+		_ = conn.Close()
+	}), 0)
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = ln.Close() })
+
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+
+		router.ServeTCP(conn.(*net.TCPConn))
+	}()
+
+	assert.Equal(t, payload, dialPostTLS(t, ln.Addr().String(), []string{"http/1.1"}, payload, 0))
+}
