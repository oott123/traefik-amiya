+// postTLSRouter is the second routing stage: it performs the TLS handshake that
+// net/http would otherwise perform lazily, sniffs the application protocol of the
+// decrypted stream, and matches it against the post-TLS routes. Connections that do
+// not match keep going down the regular HTTPS path.
+type postTLSRouter struct {
+	router *Router
+	// next is the HTTPS forwarder handling the connections that did not match.
+	next tcp.Handler
+}
+
+// ServeTCP handshakes, sniffs, and routes the decrypted connection.
+func (p *postTLSRouter) ServeTCP(conn tcp.WriteCloser) {
+	tlsConn, ok := conn.(*tls.Conn)
+	if !ok {
+		// The post-TLS router is only ever woven behind a tcp.TLSHandler.
+		log.Error().Msg("Post-TLS router got a connection which is not a TLS connection")
+		_ = conn.Close()
+		return
+	}
+
+	clientHelloConnData, ok := clientHelloConnDataOf(tlsConn)
+	if !ok {
+		// Losing the ClientHello data would silently degrade every matcher combined
+		// with AppProtocol, so this is treated as a broken invariant.
+		log.Error().Msg("Post-TLS router could not retrieve the ClientHello connection data")
+		_ = conn.Close()
+		return
+	}
+
+	if p.router.tlsHandshakeTimeout > 0 {
+		if err := tlsConn.SetDeadline(time.Now().Add(p.router.tlsHandshakeTimeout)); err != nil {
+			log.Error().Err(err).Msg("Error while setting deadline")
+		}
+	}
+
+	if err := tlsConn.HandshakeContext(context.Background()); err != nil {
+		logDebugOnConnError(err, "Error during TLS handshake")
+		_ = conn.Close()
+		return
+	}
+
+	state := tlsConn.ConnectionState()
+	pConn := newTLSPeekConn(tlsConn, state)
+
+	if err := tlsConn.SetDeadline(time.Now().Add(appProtoSniffTimeout)); err != nil {
+		log.Error().Err(err).Msg("Error while setting deadline")
+	}
+
+	appProto, sniffErr := sniffAppProtocol(pConn, state.NegotiatedProtocol)
+
+	// The deadlines were only there to bound the handshake and the sniffing,
+	// serving the connection is up to the downstream handler from now on.
+	if err := tlsConn.SetDeadline(time.Time{}); err != nil {
+		log.Error().Err(err).Msg("Error while setting deadline")
+	}
+
+	if sniffErr != nil {
+		// No conclusion could be reached, which notably covers a client that
+		// completed the handshake without sending anything, so the connection goes
+		// down the regular HTTPS path without taking part in the second stage.
+		logDebugOnConnError(sniffErr, "Error while sniffing the application protocol")
+		p.serveNext(pConn, state)
+		return
+	}
+
+	handler, _ := p.router.muxerPostTLS.Match(clientHelloConnData.WithAppProtocol(appProto))
+	if handler == nil {
+		p.serveNext(pConn, state)
+		return
+	}
+
+	log.Debug().
+		Str("appProtocol", appProto).
+		Str("serverName", state.ServerName).
+		Str("remoteAddr", pConn.RemoteAddr().String()).
+		Msg("Matched post-TLS route")
+
+	handler.ServeTCP(pConn)
+}
+
+// serveNext hands the connection over to the HTTPS forwarder.
+//
+// The wrapper type is what decides how net/http serves the connection, and it has
+// to mirror what the negotiated protocol would have led to on an unsniffed
+// connection: a bare PeekConn hides the TLS state, which sends the h2 connections
+// through the unencrypted_http2 channel and its preface detection, while
+// TLSStatefulConn exposes it, which sends the others through the native HTTP/1.x
+// branch with Request.TLS already filled in.
+func (p *postTLSRouter) serveNext(conn *PeekConn, state tls.ConnectionState) {
+	if state.NegotiatedProtocol == AppProtoH2 {
+		p.next.ServeTCP(conn)
+		return
+	}
+
+	p.next.ServeTCP(TLSStatefulConn{PeekConn: conn})
+}
+
+// clientHelloConnDataOf unwraps the ClientHello stage connection metadata from a
+// connection the HTTPS path terminated. The tcp.TLSHandler is the only wrapping
+// layer between the two stages.
+func clientHelloConnDataOf(tlsConn *tls.Conn) (tcpmuxer.ConnData, bool) {
+	tlsConnWithOptionsName, ok := tlsConn.NetConn().(tcp.TLSConn)
+	if !ok {
+		return tcpmuxer.ConnData{}, false
+	}
+
+	carrier, ok := tlsConnWithOptionsName.WriteCloser.(connDataCarrier)
+	if !ok {
+		return tcpmuxer.ConnData{}, false
+	}
+
+	return carrier.clientHelloConnData()
+}
+
+// logDebugOnConnError logs a connection error at debug level, unless it is one of
+// the ones a public entryPoint gets all the time and which would only be noise.
+func logDebugOnConnError(err error, msg string) {
+	opErr, ok := errors.AsType[*net.OpError](err)
+	if !errors.Is(err, io.EOF) && (!ok || !opErr.Timeout()) {
+		log.Debug().Err(err).Msg(msg)
+	}
+}
+
 // PeekConn wraps a tcp.WriteCloser with a bufio.Reader for Peek operations
 // and a peeked buffer that accumulates bytes consumed during protocol detection
 // so they can be replayed on subsequent Read calls.
@@ -397,6 +550,35 @@ func newTLSPeekConn(conn tcp.WriteCloser, state tls.ConnectionState) *PeekConn {
 	return pConn
 }
 
+// Peek allows peeking into the connection without consuming bytes, by using the bufio.Reader's Peek method.
+func (c *PeekConn) Peek(n int) ([]byte, error) {
+	return c.reader.Peek(n)
+}
+
+// PeekRead reads from the connection and accumulates the read bytes into the peeked buffer, allowing them to be replayed later.
+// Note that PeekRead advances the reader, thus the next call to Peek will not return the same result as the previous one.
+func (c *PeekConn) PeekRead(p []byte) (int, error) {
+	n, err := c.reader.Read(p)
+	if n > 0 {
+		c.peeked = append(c.peeked, p[:n]...)
+	}
+	return n, err
+}
+
+// Read drains accumulated peeked bytes first, then reads from the bufio reader.
+func (c *PeekConn) Read(p []byte) (int, error) {
+	if len(c.peeked) > 0 {
+		n := copy(p, c.peeked)
+		c.peeked = c.peeked[n:]
+		if len(c.peeked) == 0 {
+			c.peeked = nil
+		}
+		return n, nil
+	}
+
+	return c.reader.Read(p)
+}
+
