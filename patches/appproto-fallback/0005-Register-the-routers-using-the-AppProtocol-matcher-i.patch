 	tcpmiddleware "github.com/traefik/traefik/v3/pkg/server/middleware/tcp"
@@ -397,3 +398,128 @@ func TestRuntimeConfiguration(t *testing.T) {
 		})
 	}
 }
+
+func TestPostTLSRouterConfiguration(t *testing.T) {
+	testCases := []struct {
+		desc          string
+		router        *dynamic.TCPRouter
+		expectedError string
+	}{
+		{
+			desc: "Valid post-TLS router",
+			router: &dynamic.TCPRouter{
+				EntryPoints: []string{"websecure"},
+				Service:     "foo-service",
+				Rule:        "HostSNI(`bar.foo`) && AppProtocol(`unknown`)",
+				TLS:         &dynamic.RouterTCPTLSConfig{},
+			},
+		},
+		{
+			desc: "Valid post-TLS router without HostSNI",
+			router: &dynamic.TCPRouter{
+				EntryPoints: []string{"websecure"},
+				Service:     "foo-service",
+				Rule:        "AppProtocol(`unknown`)",
+				TLS:         &dynamic.RouterTCPTLSConfig{},
+			},
+		},
+		{
+			desc: "No TLS on the router",
+			router: &dynamic.TCPRouter{
+				EntryPoints: []string{"websecure"},
+				Service:     "foo-service",
+				Rule:        "AppProtocol(`unknown`)",
+			},
+			expectedError: "AppProtocol matcher requires TLS termination on the router",
+		},
+		{
+			desc: "TLS passthrough",
+			router: &dynamic.TCPRouter{
+				EntryPoints: []string{"websecure"},
+				Service:     "foo-service",
+				Rule:        "HostSNI(`bar.foo`) && AppProtocol(`unknown`)",
+				TLS:         &dynamic.RouterTCPTLSConfig{Passthrough: true},
+			},
+			expectedError: "AppProtocol matcher cannot be used with TLS passthrough",
+		},
+		{
+			desc: "TLS options set on the router",
+			router: &dynamic.TCPRouter{
+				EntryPoints: []string{"websecure"},
+				Service:     "foo-service",
+				Rule:        "HostSNI(`bar.foo`) && AppProtocol(`unknown`)",
+				TLS:         &dynamic.RouterTCPTLSConfig{Options: "foo"},
+			},
+			expectedError: "TLS options cannot be set on a router using the AppProtocol matcher",
+		},
+		{
+			desc: "Invalid AppProtocol value",
+			router: &dynamic.TCPRouter{
+				EntryPoints: []string{"websecure"},
+				Service:     "foo-service",
+				Rule:        "AppProtocol(`mqtt`)",
+				TLS:         &dynamic.RouterTCPTLSConfig{},
+			},
+			expectedError: "is not a valid application protocol",
+		},
+		{
+			desc: "AppProtocol matcher with the v2 rule syntax",
+			router: &dynamic.TCPRouter{
+				EntryPoints: []string{"websecure"},
+				Service:     "foo-service",
+				Rule:        "AppProtocol(`unknown`)",
+				RuleSyntax:  "v2",
+				TLS:         &dynamic.RouterTCPTLSConfig{},
+			},
+			expectedError: "error while parsing rule",
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			routerInfo := &runtime.TCPRouterInfo{TCPRouter: test.router}
+
+			conf := &runtime.Configuration{
+				TCPServices: map[string]*runtime.TCPServiceInfo{
+					"foo-service": {
+						TCPService: &dynamic.TCPService{
+							LoadBalancer: &dynamic.TCPServersLoadBalancer{
+								Servers: []dynamic.TCPServer{{Address: "127.0.0.1:8085"}},
+							},
+						},
+					},
+				},
+				TCPRouters: map[string]*runtime.TCPRouterInfo{"foo": routerInfo},
+			}
+
+			dialerManager := tcp2.NewDialerManager(nil)
+			dialerManager.Update(map[string]*dynamic.TCPServersTransport{"default@internal": {}})
+
+			tlsManager := traefiktls.NewManager(nil)
+			tlsManager.UpdateConfigs(t.Context(), map[string]traefiktls.Store{},
+				map[string]traefiktls.Options{"default": {}, "foo": {}}, []*traefiktls.CertAndStores{})
+
+			routerManager := NewManager(conf, tcp.NewManager(conf, dialerManager),
+				tcpmiddleware.NewBuilder(conf.TCPMiddlewares), nil, nil, tlsManager, nil)
+
+			router, err := routerManager.buildEntryPointHandler(t.Context(), conf.TCPRouters, nil, nil, nil)
+			require.NoError(t, err)
+
+			if test.expectedError != "" {
+				require.Len(t, routerInfo.Err, 1)
+				assert.Contains(t, routerInfo.Err[0], test.expectedError)
+				assert.False(t, router.muxerPostTLS.HasRoutes())
+				return
+			}
+
+			require.Empty(t, routerInfo.Err)
+			assert.True(t, router.muxerPostTLS.HasRoutes())
+
+			// A post-TLS router must not take part in the ClientHello stage.
+			assert.False(t, router.muxerTCP.HasRoutes())
+			assert.False(t, router.muxerTCPTLS.HasRoutes())
+		})
+	}
+}
